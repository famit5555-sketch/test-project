# ---- One-Sto Plus の設定（環境変数）----
# 公開URL（メール内のリンクに使います）。https で公開する場合はクッキーも Secure になります
BASE_URL=https://example.com
PORT=3000

# 初回起動時の管理者パスワード（ログインID: admin）
ADMIN_PASSWORD=change-me-please
# 0 にすると、初回起動時にデモデータを入れず管理者だけを作ります（本番ではこちら）
SEED_DEMO=0

# AI読み取り（Claude API）
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# メール送信（未設定の場合は送信せず、画面の「送信したメール」に記録だけ残します）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=order@example.com

# データの保存先（既定: ./data）
# DATA_DIR=/var/lib/onesto
